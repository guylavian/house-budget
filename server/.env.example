# PostgreSQL (Prisma)
DATABASE_URL=postgresql://budget:CHANGE_ME@localhost:5432/household_budget

# MongoDB
MONGODB_URI=mongodb://localhost:27017/household_budget

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated allowed frontend origins
# Development default: http://localhost:5173
# Production example: http://100.x.x.x,https://budget.home
ALLOWED_ORIGINS=http://localhost:5173

# Postgres credentials (used by docker-compose)
POSTGRES_USER=budget
POSTGRES_PASSWORD=CHANGE_ME

# AI Classification via Ollama (optional — set AI_CLASSIFICATION_ENABLED=false to disable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b
AI_CLASSIFICATION_ENABLED=true
